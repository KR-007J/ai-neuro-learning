rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Secure by default: refuse all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: only the user can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Learning assessments: publicly readable (if needed) but restricted writing
    match /assessments/{assessmentId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin/system write
    }
  }
}
